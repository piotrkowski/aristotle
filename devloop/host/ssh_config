# Use with: ssh -F devloop/host/ssh_config kindle
Host kindle
    HostName 192.168.15.244
    User root
    IdentityFile ~/.cache/aristotle/ssh/kindle_ed25519
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    UserKnownHostsFile ~/.cache/aristotle/known_hosts
    ConnectTimeout 5
    ServerAliveInterval 10
