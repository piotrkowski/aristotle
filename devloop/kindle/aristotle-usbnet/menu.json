{
  "items": [
    {
      "name": "Aristotle",
      "items": [
        {
          "name": "Install agent (SSH on every boot)",
          "action": "sh ./agent/install.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "USB drive mode for 10 minutes (agent installed)",
          "action": "sh /var/local/aristotle/aristotlectl mode storage 10",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Remove agent completely (job, state, SSH key)",
          "action": "sh ./agent/uninstall.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Migrate agent from an earlier install",
          "action": "sh ./agent/migrate.sh kual",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Undo agent migration",
          "action": "sh ./agent/rollback.sh kual",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Start USB network once (manual)",
          "action": "sh ./bin/start.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Stop USB network (manual)",
          "action": "sh ./bin/stop.sh",
          "exitmenu": false,
          "status": false
        }
      ]
    }
  ]
}
