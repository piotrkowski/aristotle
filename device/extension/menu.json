{
  "items": [
    {
      "name": "Aristotle",
      "items": [
        {
          "name": "Start Aristotle",
          "action": "sh ./bin/aristotle-start.sh",
          "exitmenu": true,
          "status": false
        },
        {
          "name": "Return to the Kindle interface",
          "action": "sh ./bin/aristotle-stop.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Start Aristotle at boot: on (agent installed)",
          "action": "sh ./agent/autostart.sh on",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Start Aristotle at boot: off",
          "action": "sh ./agent/autostart.sh off",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Install agent (SSH on every boot, no Amazon updates)",
          "action": "sh ./agent/install.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "USB drive mode for 10 minutes (agent installed)",
          "action": "sh /var/local/aristotle/aristotlectl mode storage 10",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Remove agent completely (jobs, state, SSH key)",
          "action": "sh ./agent/uninstall.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Start USB network once (manual)",
          "action": "sh ./bin/start.sh",
          "exitmenu": false,
          "status": false
        },
        {
          "name": "Stop USB network (manual)",
          "action": "sh ./bin/stop.sh",
          "exitmenu": false,
          "status": false
        }
      ]
    }
  ]
}
